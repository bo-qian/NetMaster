<UserControl x:Class="NetMaster.WinUI.StatusIndicator"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Name="StatusRoot" IsTabStop="False" FontWeight="SemiBold">
 <Grid ColumnSpacing="8">
  <VisualStateManager.VisualStateGroups>
   <VisualStateGroup x:Name="ToneStates">
    <VisualState x:Name="Neutral"><VisualState.Setters>
     <Setter Target="StatusIcon.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Target="StatusIcon.Symbol" Value="Message"/>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Success"><VisualState.Setters>
     <Setter Target="StatusIcon.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/><Setter Target="StatusIcon.Symbol" Value="Accept"/>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Attention"><VisualState.Setters>
     <Setter Target="StatusIcon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/><Setter Target="StatusIcon.Symbol" Value="Message"/>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Working"><VisualState.Setters>
     <Setter Target="StatusIcon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/><Setter Target="StatusIcon.Symbol" Value="Sync"/>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Caution"><VisualState.Setters>
     <Setter Target="StatusIcon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/><Setter Target="StatusIcon.Symbol" Value="Important"/>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Critical"><VisualState.Setters>
     <Setter Target="StatusIcon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/><Setter Target="StatusIcon.Symbol" Value="Cancel"/>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
    </VisualState.Setters></VisualState>
   </VisualStateGroup>
  </VisualStateManager.VisualStateGroups>
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Viewbox Width="{Binding IconSize, ElementName=StatusRoot}" Height="{Binding IconSize, ElementName=StatusRoot}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"><SymbolIcon x:Name="StatusIcon" Symbol="Message"/></Viewbox>
  <TextBlock x:Name="StatusLabel" Grid.Column="1" Text="{Binding Text, ElementName=StatusRoot}" FontSize="{Binding FontSize, ElementName=StatusRoot}" FontWeight="{Binding FontWeight, ElementName=StatusRoot}" TextWrapping="Wrap" VerticalAlignment="Center"/>
 </Grid>
</UserControl>
