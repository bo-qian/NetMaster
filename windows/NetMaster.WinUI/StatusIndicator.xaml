<UserControl x:Class="NetMaster.WinUI.StatusIndicator"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Name="StatusRoot" IsTabStop="False" FontWeight="SemiBold">
 <Border x:Name="StatusAccentBorder" BorderThickness="2,0,0,0" Padding="8,0,0,0" CornerRadius="1">
  <VisualStateManager.VisualStateGroups>
   <VisualStateGroup x:Name="ToneStates">
    <VisualState x:Name="Neutral"><VisualState.Setters>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
     <Setter Target="StatusAccentBorder.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Success"><VisualState.Setters>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
     <Setter Target="StatusAccentBorder.BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Attention"><VisualState.Setters>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
     <Setter Target="StatusAccentBorder.BorderBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Working"><VisualState.Setters>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
     <Setter Target="StatusAccentBorder.BorderBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Caution"><VisualState.Setters>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
     <Setter Target="StatusAccentBorder.BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}"/>
    </VisualState.Setters></VisualState>
    <VisualState x:Name="Critical"><VisualState.Setters>
     <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
     <Setter Target="StatusAccentBorder.BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
    </VisualState.Setters></VisualState>
   </VisualStateGroup>
  </VisualStateManager.VisualStateGroups>
  <TextBlock x:Name="StatusLabel" Text="{Binding Text, ElementName=StatusRoot}" FontSize="{Binding FontSize, ElementName=StatusRoot}" FontWeight="{Binding FontWeight, ElementName=StatusRoot}" TextWrapping="Wrap" VerticalAlignment="Center"/>
 </Border>
</UserControl>
