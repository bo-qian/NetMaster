<Window x:Class="NetMaster.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NetMaster">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <Grid x:Name="Root" Background="Transparent" SizeChanged="Root_SizeChanged">
  <Grid.Resources>
   <Style x:Key="Card" TargetType="Border">
    <Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/>
   </Style>
   <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TitleBar x:Name="AppTitleBar" Title="NetMaster" Subtitle="校园网助手" Background="Transparent">
   <TitleBar.IconSource><ImageIconSource ImageSource="ms-appx:///Assets/NetMaster.png"/></TitleBar.IconSource>
  </TitleBar>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="200" IsPaneToggleButtonVisible="True" SelectionChanged="Navigation_SelectionChanged" ItemInvoked="Navigation_ItemInvoked">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="概览" Tag="overview"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="配置" Tag="login"><NavigationViewItem.Icon><SymbolIcon Symbol="Globe"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="日志" Tag="logs"><NavigationViewItem.Icon><SymbolIcon Symbol="Document"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem Content="设置" Tag="settings" SelectsOnInvoked="False"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.FooterMenuItems>
   <ScrollViewer x:Name="ContentViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="ContentViewport_SizeChanged">
   <Grid x:Name="PageLayout" Padding="24,18,24,24" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

     <StackPanel Spacing="4"><TextBlock x:Name="PageHeading" Text="概览" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="连接状态与最近活动" Opacity="0.7"/></StackPanel>
     <InfoBar x:Name="StatusNotice" Grid.Row="1" IsOpen="True" IsClosable="False" Title="正在启动" Message="正在读取配置并连接后台…"/>
     <Grid x:Name="OverviewPanel" Grid.Row="2" RowSpacing="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="110"/></Grid.RowDefinitions>
      <Grid x:Name="StatusCards" ColumnSpacing="18" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
        <TextBlock Text="校园网连接" Style="{StaticResource Heading}"/><TextBlock x:Name="NetworkStatus" Text="尚未检测" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock x:Name="OverviewAccount" Text="配置账号：未获取" Opacity="0.7"/><TextBlock x:Name="LastCheck" Text="上次检测：暂无" Opacity="0.7"/>
        <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="OverviewConfigureButton" Content="开始配置" Click="Login_Click"/><Button x:Name="DetectButton" Content="重新检测" Click="Detect_Click"/></StackPanel>
       </StackPanel></Border>
       <Border x:Name="GuardCard" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="10">
        <TextBlock Text="自动守护" Style="{StaticResource Heading}"/><TextBlock x:Name="GuardStatus" Text="未配置" FontSize="26" TextWrapping="Wrap"/>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="断网自动重连" VerticalAlignment="Center" Opacity="0.7"/><ToggleSwitch x:Name="ReconnectToggle" Grid.Column="1" MinWidth="0" Height="32" OffContent="" OnContent="" Toggled="Reconnect_Toggled" IsEnabled="False" AutomationProperties.Name="断网自动重连"/></Grid><TextBlock x:Name="IntervalLabel" Text="检测间隔：20 秒" Opacity="0.7"/>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Windows 登录后启动" VerticalAlignment="Center" Opacity="0.7"/><ToggleSwitch x:Name="StartupToggle" Grid.Column="1" MinWidth="0" Height="32" OffContent="" OnContent="" Toggled="Startup_Toggled" IsEnabled="False" AutomationProperties.Name="Windows 登录后启动"/></Grid>
       </StackPanel></Border>
      </Grid>
      <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel Spacing="10">
       <Grid><TextBlock Text="网络测速" Style="{StaticResource Heading}"/><Button x:Name="SpeedButton" Content="开始测速" HorizontalAlignment="Right" Click="Speed_Click"/></Grid>
       <Grid x:Name="SpeedMetrics" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
        <StackPanel x:Name="DownloadMetric" Spacing="8"><TextBlock Text="下载" Opacity="0.7" VerticalAlignment="Center"/><TextBlock x:Name="DownloadValue" Text="— Mbps" FontSize="30" TextWrapping="Wrap"/></StackPanel>
        <StackPanel x:Name="UploadMetric" Grid.Column="1" Spacing="8"><TextBlock Text="上传" Opacity="0.7" VerticalAlignment="Center"/><TextBlock x:Name="UploadValue" Text="— Mbps" FontSize="30" TextWrapping="Wrap"/></StackPanel>
        <StackPanel x:Name="LatencyMetric" Grid.Column="2" Spacing="8"><TextBlock Text="延迟" Opacity="0.7" VerticalAlignment="Center"/><TextBlock x:Name="LatencyValue" Text="— ms" FontSize="30" TextWrapping="Wrap"/></StackPanel>
       </Grid><TextBlock x:Name="SpeedMessage" Text="按需测试，将访问 Cloudflare 并使用约 25 MB 流量。" TextWrapping="Wrap" Opacity="0.7"/>
      </StackPanel></Border>
      <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel Spacing="14">
       <Grid><TextBlock Text="最近日志" Style="{StaticResource Heading}"/><HyperlinkButton Content="查看全部" HorizontalAlignment="Right" Click="Logs_Click"/></Grid>
       <TextBlock x:Name="RecentLogs" Text="暂无日志。" TextWrapping="Wrap" Opacity="0.7"/>
      </StackPanel></Border>
     </Grid>
     <Grid x:Name="ConfigurationPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
       <TextBlock x:Name="ConfigurationState" Text="尚未配置" FontSize="26" FontWeight="SemiBold"/>
       <TextBlock x:Name="ConfigurationAccount" Text="配置一次，之后由 NetMaster 自动检测并恢复校园网连接。" TextWrapping="Wrap" Opacity="0.7"/>
       <TextBlock x:Name="ConfigurationSteps" Text="① 获取登录信息　→　② 确认有效　→　③ 保存并启用守护" TextWrapping="Wrap"/>
       <TextBlock x:Name="ConfigurationMessage" Text="点击开始配置，软件会引导你完成认证。" TextWrapping="Wrap" Opacity="0.7"/>
       <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="StartConfigurationButton" Content="开始配置" Click="StartConfiguration_Click"/><Button x:Name="RestartAuthenticationButton" Content="重新认证" Click="RestartAuthentication_Click" Visibility="Collapsed"/><Button x:Name="CancelConfigurationButton" Content="取消配置" Click="CancelConfiguration_Click" Visibility="Collapsed"/></StackPanel>
      </StackPanel></Border>
     <Grid x:Name="LoginPanel" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="18" RowSpacing="16"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="PortalCard" MinHeight="380" Style="{StaticResource Card}"><Grid RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="获取登录信息" Style="{StaticResource Heading}"/>
       <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Text="http://10.10.9.9" IsReadOnly="True" AutomationProperties.Name="校园网地址"/>
        <Button Grid.Column="1" Content="刷新" Click="RefreshPortal_Click"/><Button Grid.Column="2" Content="在浏览器中打开" Click="OpenPortal_Click"/>
       </Grid>
       <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8"><WebView2 x:Name="PortalWeb" MinHeight="260"/></Border>
       <TextBlock Grid.Row="3" x:Name="PortalStatus" Text="请在校园网环境打开认证网页。" TextWrapping="Wrap" Opacity="0.7"/>
      </Grid></Border>
      <Border x:Name="LoginInfoCard" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="20">
       <TextBlock Text="登录信息" Style="{StaticResource Heading}"/><TextBlock x:Name="LoginState" Text="等待登录" FontSize="26" TextWrapping="Wrap"/>
       <TextBlock x:Name="LoginAccount" Text="配置账号：未获取"/><TextBlock x:Name="LoginSaved" Text="登录信息：未保存"/>
       <TextBlock x:Name="LoginExplanation" Text="完成网页认证并获取登录信息后，才能验证、保存并启用守护。" TextWrapping="Wrap" Opacity="0.7"/>
       <Button x:Name="ValidateButton" Content="验证登录" Click="Validate_Click" IsEnabled="False" HorizontalAlignment="Stretch"/><Button x:Name="SaveProfileButton" Content="保存并启用守护" Click="SaveProfile_Click" IsEnabled="False" HorizontalAlignment="Stretch"/>
      </StackPanel></Border>
     </Grid>
     </Grid>
     <Grid x:Name="LogsPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14">
       <Grid x:Name="LogFilters" ColumnSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <AutoSuggestBox x:Name="LogSearch" PlaceholderText="搜索日志" TextChanged="LogSearch_Changed" AutomationProperties.Name="搜索日志"/>
        <ComboBox x:Name="LogLevel" Grid.Column="1" SelectedIndex="0" SelectionChanged="LogFilter_Changed" HorizontalAlignment="Stretch" AutomationProperties.Name="日志级别"><ComboBoxItem Content="全部级别"/><ComboBoxItem Content="信息"/><ComboBoxItem Content="警告"/><ComboBoxItem Content="错误"/></ComboBox>
        <ComboBox x:Name="LogDate" Grid.Column="2" SelectedIndex="0" SelectionChanged="LogFilter_Changed" HorizontalAlignment="Stretch" AutomationProperties.Name="日志日期"><ComboBoxItem Content="全部日期"/><ComboBoxItem Content="今天"/><ComboBoxItem Content="最近 7 天"/></ComboBox>
        <Button x:Name="LogExport" Grid.Column="3" Content="导出" Click="Export_Click"/>
       </Grid><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="实时更新" VerticalAlignment="Center" Opacity="0.7"/><ToggleSwitch x:Name="LiveLogs" MinWidth="0" Height="32" OffContent="" OnContent="" IsOn="True" Toggled="LiveLogs_Toggled" AutomationProperties.Name="实时更新"/></StackPanel>
      </StackPanel></Border>
      <Border Grid.Row="1" Style="{StaticResource Card}"><Grid RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="56"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="时间" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="级别" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="事件" FontWeight="SemiBold"/>
       </Grid>
       <Grid Grid.Row="1" MinHeight="150"><ListView x:Name="LogList" MaxHeight="320" SelectionChanged="LogList_SelectionChanged">
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,8"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="56"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeLabel}"/><TextBlock Grid.Column="1" Text="{Binding Level}"/><TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate>
       </ListView><TextBlock x:Name="LogsEmpty" Text="暂无符合条件的日志" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="22"/></Grid>
       <Grid x:Name="LogFooter" Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions><StackPanel x:Name="LogFooterOptions" Orientation="Horizontal" Spacing="12"><CheckBox x:Name="AutoScroll" Content="自动滚动" IsChecked="True"/><TextBlock x:Name="LogCount" Text="已显示 0 条记录" VerticalAlignment="Center" Opacity="0.7"/><Button x:Name="MoreLogs" Content="更多" Click="MoreLogs_Click"/></StackPanel><Button x:Name="CopyLogButton" Grid.Column="1" Content="复制选中记录" Click="CopyLog_Click" HorizontalAlignment="Right" IsEnabled="False"/></Grid>
      </Grid></Border>
      <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock Text="记录详情" Style="{StaticResource Heading}"/><TextBlock x:Name="LogDetails" Text="选择一条记录以查看详细信息。" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.7"/></StackPanel></Border>
     </Grid>
   </Grid>
   </ScrollViewer>
  </NavigationView>
 </Grid>
</Window>
