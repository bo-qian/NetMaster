<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NetMaster.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\netmaster-icon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="PortalCapture.js" />
    <EmbeddedResource Include="PortalAccount.js" />
    <EmbeddedResource Include="PortalLayout.js" />
    <Content Include="Assets\NetMaster.png" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NetMaster.Core/NetMaster.Core.csproj" />
    <ProjectReference Include="../NetMaster.Worker/NetMaster.Worker.csproj" ReferenceOutputAssembly="false" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <Target Name="IncludeWorker" BeforeTargets="GetCopyToOutputDirectoryItems;_ComputeAppxPackagePayload" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../NetMaster.Worker/NetMaster.Worker.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="WorkerPath" />
    </MSBuild>
    <ItemGroup>
      <WorkerFile Include="@(WorkerPath->'%(RootDir)%(Directory)NetMaster.Worker.exe');@(WorkerPath->'%(RootDir)%(Directory)NetMaster.Worker.dll');@(WorkerPath->'%(RootDir)%(Directory)NetMaster.Worker.deps.json');@(WorkerPath->'%(RootDir)%(Directory)NetMaster.Worker.runtimeconfig.json')" />
      <Content Include="@(WorkerFile)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <!-- ResolveProjectReferences runs after AssignTargetPaths. Include the
           worker assembly explicitly in copy and MSIX payload items. -->
      <ContentWithTargetPath Include="@(WorkerPath)" TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Package signing authenticates the container. Sign our executable code
       separately for local development, before MSIX creates its integrity catalog.
       These properties are supplied only by Build-DevelopmentPackage.ps1. -->
  <Target Name="SignLocalDevelopmentBinaries" AfterTargets="_ComputeAppxPackagePayload"
          Condition="'$(NetMasterDevelopmentCertificateThumbprint)' != ''">
    <Error Condition="!Exists('$(NetMasterDevelopmentSignTool)')" Text="The development signing tool was not found." />
    <ItemGroup>
      <!-- Sign the canonical files chosen by MSIX after it deduplicates obj/bin
           inputs. Signing only bin earlier makes identical inputs diverge. -->
      <NetMasterDevelopmentBinary Include="@(AppxPackagePayload)"
          Condition="'%(TargetPath)' == 'NetMaster.WinUI.exe' Or '%(TargetPath)' == 'NetMaster.WinUI.dll' Or '%(TargetPath)' == 'NetMaster.Worker.exe' Or '%(TargetPath)' == 'NetMaster.Worker.dll' Or '%(TargetPath)' == 'NetMaster.Core.dll'" />
    </ItemGroup>
    <Error Condition="'@(NetMasterDevelopmentBinary->Count())' != '5'" Text="Expected all five NetMaster executable binaries in the development payload; found @(NetMasterDevelopmentBinary->'%(TargetPath)')." />
    <Error Condition="!Exists('%(NetMasterDevelopmentBinary.Identity)')" Text="Missing development binary: %(NetMasterDevelopmentBinary.Identity)" />
    <Exec Command="&quot;$(NetMasterDevelopmentSignTool)&quot; sign /fd SHA256 /sha1 $(NetMasterDevelopmentCertificateThumbprint) &quot;%(NetMasterDevelopmentBinary.FullPath)&quot;" />
    <Exec Command="&quot;$(NetMasterDevelopmentSignTool)&quot; verify /pa &quot;%(NetMasterDevelopmentBinary.FullPath)&quot;" />
    <Copy SourceFiles="@(NetMasterDevelopmentBinary)" DestinationFiles="@(NetMasterDevelopmentBinary->'$(OutDir)%(TargetPath)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- JSON reflection and Task Scheduler COM need their full metadata. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
